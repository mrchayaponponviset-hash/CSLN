# =============================================================================
# 📋 Backend Environment Variables — CSLearning Platform
# =============================================================================
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง:
#   cp .env.example .env
#
# ⚠️ ห้าม commit ไฟล์ .env ขึ้น Git โดยเด็ดขาด
# =============================================================================

# === Server ===
PORT=5000

# === OpenRouter API (LLM Gateway) ===
# ลงทะเบียนที่: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_GENERATOR_MODEL=openai/gpt-oss-20b:free
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# === Supabase (Database) ===
# สร้าง Project ที่: https://supabase.com/
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# === Encryption Key สำหรับระบบ BYOK ===
# ⚠️ สำคัญมาก: สร้าง key ใหม่ด้วยคำสั่ง:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ ห้ามเปลี่ยนหลัง deploy — ไม่งั้น key ที่เข้ารหัสไว้จะถอดรหัสไม่ได้
ENCRYPTION_KEY=your_generated_fernet_key_here

# === CORS Origins ===
# กำหนด domain ที่อนุญาตให้เรียก API (คั่นด้วยจุลภาค)
# สำหรับ production ให้เพิ่ม URL จริง เช่น:
#   CORS_ORIGINS=http://localhost:3000,https://cslearning.your-org.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# === Application URL (สำหรับ HTTP-Referer header ไปยัง OpenRouter) ===
APP_URL=http://localhost:5173
